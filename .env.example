# Rename this file to .env and fill in real values.
# NEVER upload the real .env to GitHub - it's already in .gitignore.

# Your PostgreSQL database address (get this free from neon.tech)
DATABASE_URL="postgresql://username:password@ep-xxxx.neon.tech/dbname?sslmode=require"

# A long random secret used to sign login tokens (JWT). Type anything random and long.
JWT_SECRET="replace_this_with_a_long_random_string"

# Your site's own address - used by middleware/redirects
NEXT_PUBLIC_BASE_URL=http://localhost:3000
